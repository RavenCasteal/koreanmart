# Virtual environment (never commit - machine-specific, large)
.venv/

# Python bytecode cache (auto-generated)
__pycache__/
*.pyc
*.pyo

# SQLite database (contains user data, password hashes, sales history)
database/*.db
database/*.db-wal
database/*.db-shm
database/*.db-journal

# Backups (generated by the app and reset script)
backups/
database/backups/

# Receipts (generated at sale time)
receipts/

# Logs (generated at runtime)
logs/

# Reports (generated by Z-read / CSV export)
reports/

# Printer config (per-machine)
config/

# Test/smoke output captures
*_out.txt
tests_out.txt

# GUI smoke-test harnesses (development tools, not needed to run the app)
stage*_smoke.py

# OS files
Thumbs.db
.DESKTOP
$RECYCLE.BIN/
